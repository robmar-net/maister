# Generated compatibility reports are run artifacts, not source — ignore them,
# but keep the directory (via .gitkeep) so the harness always has somewhere to write.
compat-report-*.md
l1-hook-effects-*.md
l2-trace-equivalence-*.md
# L2 replay trace bundles (Stage 4) — git-ignored per-run raw traces (reports/<ts>/{events.json,rundir/,replay-meta.json}).
# `*/` catches only per-run SUBDIRECTORIES; the tracked `.gitkeep` is a FILE, so it stays tracked (kept explicit below).
*/
!.gitkeep
